// Cloudflare Worker, který servíruje sestavený web z frontend/dist.
// Build spouští sám `wrangler deploy` (sekce build), v nastavení Cloudflare stačí deploy command.
{
  "name": "underthespotlight",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "cd frontend && npm ci && npm run build"
  },
  "assets": {
    "directory": "./frontend/dist",
    // Adresy jako /nba/clanky/<slug> obslouží Vue router.
    "not_found_handling": "single-page-application"
  }
}
